# Copia este archivo como .env y llena tus datos. NUNCA subas el .env a GitHub.
TELEGRAM_TOKEN=pega_aqui_el_token_de_BotFather
# Tu ID de Telegram (te lo da @userinfobot). Varios separados por coma.
ADMIN_IDS=123456789

# gratis = periodo de prueba (sin cobros ni marca de agua)
# pago   = fotos gratis limitadas con marca + creditos con /comprar
MODO=gratis
# Limite de fotos por persona al dia (en prueba es solo para no saturar el servidor)
FOTOS_GRATIS_DIA=50
# Marca de agua de las fotos gratis (vacio = sin marca)
MARCA_GRATIS=

# --- Solo se usan con MODO=pago ---
TEXTO_PRECIOS=• 50 fotos: RD$300\n• 200 fotos: RD$1,000\n• 500 fotos: RD$2,000
TEXTO_PAGO=Transferencia (Banreservas / Popular) o PayPal. Envia el comprobante a @tu_usuario con tu ID.

BOT_DB=bot.db
